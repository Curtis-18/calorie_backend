# ---- required: the app will not boot without these ----
# Supabase project URL, no trailing slash.
SUPABASE_URL=https://yourproject.supabase.co

# Supabase connection string. The pooled port (6543) is correct for a
# long-lived service. A bare postgresql:// URL is rewritten to
# postgresql+asyncpg:// automatically, so either form works.
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ---- third party keys ----
USDA_API_KEY=
GEMINI_API_KEY=

# ---- optional ----
# Comma separated list of web origins allowed to call this API. Set this to
# your deployed frontend origin, otherwise the browser blocks every response
# with "400 Disallowed CORS origin" and the Flutter client reports it as
# "Could not reach the server". `*` works as a host wildcard, so
# https://my-app-*.vercel.app covers production plus every Vercel preview.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-app-*.vercel.app

GEMINI_MODEL=gemini-3.6-flash
MAX_PHOTO_BYTES=8388608
